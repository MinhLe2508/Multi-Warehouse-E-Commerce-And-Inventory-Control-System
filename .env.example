POSTGRES_USER=warehouse
POSTGRES_PASSWORD=<MAT KHAU POSTGRESQL CỦA MÁY BẠN, NEU KHONG CO THI BO TRONG>
POSTGRES_DB=warehouse
POSTGRES_PORT=5433
REDIS_PORT=6379
PORT=3001
FRONTEND_PORT=3000

DATABASE_URL=postgresql://warehouse:<MAT KHAU POSTGRESQL CỦA MÁY BẠN, NEU KHONG CO THI BO TRONG>@localhost:5433/warehouse
REDIS_URL=redis://localhost:6379

# Chỉ đặt true khi seed PostgreSQL demo trên máy local.
ALLOW_DEMO_SEED=false

# Chuẩn bị dữ liệu kiểm thử tải. Bật trên database local hoặc đặt URL database kiểm thử riêng.
# Khi dùng URL riêng, Backend phải chạy trên đúng database đó.
ALLOW_LOAD_TEST_SETUP=false
LOAD_TEST_DATABASE_URL=

JWT_SECRET=Ma_ngau_nhien_sinh_tu_dong_bang_cau_lenh_ben_duoi

# Địa chỉ Frontend dùng để tạo link kích hoạt tài khoản.
FRONTEND_ORIGIN=http://localhost:3000

# Địa chỉ Backend mà trình duyệt gọi API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- CẤU HÌNH CHATBOT RAG & EMBEDDINGS (Để trống nếu dùng chế độ Local Fallback) ---
# Voyage AI (vector 1024 chiều cho pgvector; nếu để trống sẽ tự fallback sang tìm kiếm từ khóa)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
VOYAGE_API_TIMEOUT_MS=10000

# Nhà cung cấp LLM sinh câu trả lời (ưu tiên Claude nếu có, tiếp theo Gemini, hoặc RAG nội bộ nếu để trống)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
EVAL_DELAY_MS=0

# --- THANH TOÁN CHUYỂN KHOẢN VIETQR (Vietcombank) ---
# Điền hai trường tài khoản nhận để bật VietQR. Admin xử lý yêu cầu đối soát của khách qua sao kê.
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=
# Secret ký HMAC do bên nhận webhook và SePay dùng chung (ít nhất 32 ký tự).
# Có thể để trống khi đối soát sao kê trong Admin.
SEPAY_WEBHOOK_SECRET=
# API v2 dự phòng khi webhook đến chậm. API Token và UUID tài khoản lấy từ SePay.
SEPAY_API_TOKEN=
SEPAY_BANK_ACCOUNT_ID=


JWT_ACCESS_SECRET=Ma_ngau_nhien_sinh_tu_dong_bang_cau_lenh_ben_duoi
JWT_REFRESH_SECRET=Ma_ngau_nhien_sinh_tu_dong_bang_cau_lenh_ben_duoi
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

EMAIL_VERIFICATION_TTL_SECONDS=60
STAFF_INVITATION_TTL_SECONDS=60
PASSWORD_RESET_TTL_SECONDS=900

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx


# Copy file này và đổi tên thành ".env" trong thư mục gốc của dự án.
# Sau đó, điền các giá trị thích hợp cho các biến môi trường như mật khẩu cơ sở dữ liệu, khóa bí mật JWT, v.v.
# Để ứng dụng có thể chạy đúng cách.

# <MAT KHAU POSTGRESQL CỦA MÁY BẠN, NEU KHONG CO THI BO TRONG> là mật khẩu PostgreSQL của máy bạn khi tải ứng dụng
# Nó có bắt đặt mật khẩu, hãy điền mật khẩu đó vào <MAT KHAU POSTGRESQL CỦA MÁY BẠN, NEU KHONG CO THI BO TRONG>, bỏ dấu <> nhá.

# Tạo mã ngẫu nhiên bằng câu lệnh dưới đây:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Tạo ngẫu nhiên xong, copy chúng và điền vào ô thích hợp như trên.

# --- DÙNG EMAIL CÁ NHÂN ---
# 1. Tạo App Password Gmail:
#    - Vào: https://myaccount.google.com/security
#    - Bật "2-Step Verification"
#    - Tạo "App Password" bằng cách:
#      + Tìm kiếm "Mật khẩu ứng dụng" trên trang: https://myaccount.google.com/security
#      + Sau đó tạo mật khẩu và copy mật khẩu 16 ký tự đó.

# 2. Copy và đổi tên file tại thư mục gốc dự án: .env.example → .env

# 3. Điền email cá nhân vào file .env:
#    GMAIL_USER=your-email@gmail.com
#    GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
